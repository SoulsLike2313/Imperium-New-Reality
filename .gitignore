# === IMPERIUM hygiene additions (FIX-1) ===
# Build artifacts must never be committed to source.
target/
**/target/
node_modules/
**/node_modules/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# Compiled / binary artifacts
*.rlib
*.rmeta
*.pdb
*.dll
*.exe
*.lib
*.so
*.dylib

# Local patch / backup workflow residue
.imperium_patch_backups/

# Zip payload must be admitted, not silently committed.
# Block all zip by default; allow only declared small fixtures.
*.zip
!**/FIXTURES/**/*.zip
!**/fixtures/**/*.zip
# === IMPERIUM hygiene additions (DOCTR-TOOLS-0001) ===
# Harness runtime artifacts (e3_runner, kernel_guard, doctrinarium_integrity receipts).
# Receipts live in this tree at runtime; pack snapshots persist them elsewhere.
_HARNESS/_RUNS/
**/_HARNESS/_RUNS/

# === IMPERIUM REALITY-HYGIENE-GUARD-0001 ===
# Inquisition runtime negative-experience receipts are evidence, not source.
# They must live in HARNESS or remain ignored when legacy tools emit repo-local files.
_HARNESS/_NEGATIVE_EXPERIENCE/
**/_HARNESS/_NEGATIVE_EXPERIENCE/
# === /IMPERIUM REALITY-HYGIENE-GUARD-0001 ===

