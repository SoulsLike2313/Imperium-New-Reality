        "inq_pi_scan_owner":  {"verdict": "BLOCK_PI",    "exit_code": 1, "findings_count_min": 1, "finding_kinds_min_subset": ["ignore_directives"]}
      },
      "notes": "3 strong vectors (ignore_directives weight=3 fires multiple times + role injection signal) push score >= OWNER threshold 5. Both audiences BLOCK."
    },
