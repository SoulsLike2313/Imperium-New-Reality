{
  "schema_version": "inq.goldens.v0_1",
  "description": "Snapshot goldens for 20 INQ fixtures. Each entry maps fixture id to expected verdict subset that the test harness compares against actual tool output (volatile fields like issued_utc are excluded from comparison).",
  "comparison_keys": ["verdict", "stage", "exit_code", "finding_kinds_min_subset", "findings_count_min", "findings_count_max"],
  "category_name_note": "finding_kinds_min_subset values use SIGNATURES.json category keys for PI (ignore_directives, role_injection, jailbreak_vocabulary, prompt_leak, code_comment_injection, multilingual_ru, multilingual_cn_es_ar) and secrets pattern names (openai_anthropic, aws_access_keys, github_tokens, slack_tokens, google_api, private_key_blocks, notion_gitlab_linear, generic_high_entropy). Anomaly kinds use detector-emitted names (FIRST_AUTHOR, ANOMALY_ORGAN, ANOMALY_SCHEMA, ANOMALY_SUBMITTER).",
  "goldens": {
