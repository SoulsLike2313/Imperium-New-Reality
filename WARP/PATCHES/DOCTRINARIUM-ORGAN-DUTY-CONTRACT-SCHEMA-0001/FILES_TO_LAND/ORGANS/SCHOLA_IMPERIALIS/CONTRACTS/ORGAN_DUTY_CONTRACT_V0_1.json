    "claim final verdict or crown verdict"
  ],
  "accepted_inputs": [
    "task_receipt_chain",
    "failure_report",
    "owner_question",
    "external_audit_lesson",
    "workflow_trace"
  ],
  "required_outputs": [
    "lesson_record",
    "human_explanation",
    "agent_onboarding_note",
    "failure_pattern_summary",
    "training_memory_candidate"
  ],
  "required_receipts": [
    "schola_lesson_receipt.json",
    "human_explanation_receipt.json",
    "agent_onboarding_receipt.json"
  ],
  "rule_validators_required": [
    "schola_imperialis_duty_contract_rule_validator.v0_1",
    "schola_imperialis_forbidden_action_boundary_validator.v0_1"
  ],
  "action_validators_required": [
    "schola_imperialis_profile_action_validator.v0_1",
    "schola_imperialis_receipt_output_validator.v0_1"
  ],
  "trust_validators_required": [
    "schola_imperialis_cross_organ_trust_validator.v0_1",
    "throne_schola_imperialis_truth_confirmation_validator.v0_1"
  ],
  "handoff_in": [
    "THRONE",
    "ADMINISTRATUM",
    "INQUISITION"
  ],
  "handoff_out": [
    "DOCTRINARIUM",
    "THRONE",
    "OFFICIO_AGENTIS"
  ],
  "audited_by": [
    "DOCTRINARIUM",
    "INQUISITION",
    "THRONE"
  ],
  "throne_must_confirm": [
