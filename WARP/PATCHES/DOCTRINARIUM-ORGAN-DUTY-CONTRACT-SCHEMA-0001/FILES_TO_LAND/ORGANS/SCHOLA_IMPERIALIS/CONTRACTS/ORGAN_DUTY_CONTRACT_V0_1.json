{
  "contract_id": "schola_imperialis.organ_duty_contract.v0_1",
  "contract_version": "0.1",
  "status": "DUTY_DEFINED_ONLY",
  "organ_id": "SCHOLA_IMPERIALIS",
  "organ_class": "GREAT_NINE",
