    "target_gap_report",
    "organ_truth_stage_report",
    "score_contract_report",
    "next_attention_areas"
  ],
  "required_receipts": [
    "throne_target_gap_receipt.json",
    "throne_organ_truth_receipt.json",
    "throne_score_contract_receipt.json"
  ],
  "rule_validators_required": [
    "throne_duty_contract_rule_validator.v0_1",
    "throne_forbidden_action_boundary_validator.v0_1"
  ],
  "action_validators_required": [
    "throne_profile_action_validator.v0_1",
    "throne_receipt_output_validator.v0_1"
  ],
  "trust_validators_required": [
