    "throne_throne_truth_confirmation_validator.v0_1"
  ],
  "handoff_in": [
    "ALL_ORGANS",
    "OWNER",
    "EXTERNAL_AUDIT"
  ],
  "handoff_out": [
    "OWNER",
    "ADMINISTRATUM",
    "SCHOLA_IMPERIALIS",
    "WARP"
  ],
  "audited_by": [
    "CUSTODES",
    "INQUISITION",
    "EXTERNAL_AUDIT",
    "OWNER"
  ],
  "throne_must_confirm": [
