        "pip_version_optional",
        "venv_policy_optional"
      ],
      "proof_commands": [
        "python --version",
        "python -m py_compile <validator>.py"
      ],
      "python_binding_strategy": [
        "native",
        "subprocess to compiled tools",
        "JSON stdin/stdout bridge"
      ],
      "risk": [
        "dependency drift",
        "slow hot paths",
        "runtime-only errors"
      ]
    },
    {
