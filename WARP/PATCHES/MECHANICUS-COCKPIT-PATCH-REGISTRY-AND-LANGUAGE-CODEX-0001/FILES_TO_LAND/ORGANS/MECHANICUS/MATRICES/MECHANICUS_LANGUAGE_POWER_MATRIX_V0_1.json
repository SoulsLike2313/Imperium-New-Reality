      "use_when": [
        "validator must be hard to fake",
        "tool should compile",
        "memory safety matters",
        "Tauri backend"
      ],
      "avoid_when": [
        "one-off tiny glue",
        "team lacks time for compile/debug loop"
      ],
      "toolchain_evidence": [
