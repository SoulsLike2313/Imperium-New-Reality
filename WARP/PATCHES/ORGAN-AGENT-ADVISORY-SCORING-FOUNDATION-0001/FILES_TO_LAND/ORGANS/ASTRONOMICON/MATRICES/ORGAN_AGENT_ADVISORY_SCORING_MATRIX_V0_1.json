{
  "matrix_id": "ORGAN_AGENT_ADVISORY_SCORING_MATRIX_V0_1",
  "version": "0.1",
  "owner": "ASTRONOMICON",
  "status": "ACTIVE_ADVISORY_FOUNDATION",
  "patch_id": "ORGAN-AGENT-ADVISORY-SCORING-FOUNDATION-0001",
  "purpose": "Create a conversational organ-agent advisory layer with mathematical future-step success scoring and strict no-direct-action language.",
  "success_score_formula": {
    "name": "future_step_success_score_v0_1",
    "range": "0..100",
    "weighted_terms": {
      "evidence_strength": 0.18,
      "validator_availability": 0.16,
      "authority_clarity": 0.14,
      "scope_clarity": 0.12,
      "dependency_readiness": 0.12,
      "reversibility": 0.1,
      "risk_control": 0.1,
      "operator_clarity": 0.08
    },
    "equation": "score = sum(weight_i * factor_i), where each factor_i is 0..100",
    "attention_priority_score": "future_step_success_score * impact_score / 100"
  },
  "language_law": [
    "Organs may advise attention zones.",
    "Organs may explain why a zone matters.",
    "Organs may show evidence and gaps.",
    "Organs may recommend observation focus.",
    "Organs must not command concrete actions.",
    "Organs must not claim trust, Throne verdict, or execution authority.",
    "Each organ speaks only inside its profile domain."
  ],
  "forbidden_direct_action_terms": [
    "run",
    "execute",
    "apply",
    "commit",
    "push",
    "delete",
    "remove",
    "copy",
    "mutate",
    "запусти",
    "выполни",
    "примени",
    "закоммить",
    "запушь",
    "удали",
    "скопируй",
    "измени"
  ],
