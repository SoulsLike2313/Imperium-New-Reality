  "organ_class": "GREAT_NINE",
  "core_v1_mission": "Guard trust, permission, integrity, allowed authority, and cross-organ approval so no organ can crown itself truthful.",
  "primary_duties": [
    "verify trust chain across organs",
    "check allowed authority and forbidden actions",
    "confirm integrity receipts and permission boundaries",
    "approve or deny elevated operations",
    "record trust decisions as evidence, not prose"
