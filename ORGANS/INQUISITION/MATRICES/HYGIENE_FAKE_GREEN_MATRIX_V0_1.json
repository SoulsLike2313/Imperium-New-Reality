    { "id": "FG-SECRET", "if": "real secret material outside detector allowlist", "verdict": "BLOCK" },
    { "id": "FG-BOM", "if": "BOM in canonical receipt JSON", "verdict": "WARN_THEN_FIX" },
    { "id": "FG-CRLF", "if": "CRLF in tracked text files", "verdict": "WARN_THEN_FIX" },
    { "id": "FG-NOGIT", "if": "clean claimed without git truth receipt", "verdict": "BLOCK_OR_AUTHORITY_GAP" },
