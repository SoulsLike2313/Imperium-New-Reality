{
  "contract_id": "doctrinarium.organ_duty_contract.v0_1",
  "contract_version": "0.1",
  "status": "DUTY_DEFINED_ONLY",
  "organ_id": "DOCTRINARIUM",
  "organ_class": "GREAT_NINE",
  "core_v1_mission": "Own doctrine, rules, schemas, contracts, and specification truth for Imperium without pretending that written doctrine is operational proof.",
  "primary_duties": [
    "define machine-readable organ contracts and schemas",
    "maintain doctrine and rule documents",
    "separate target definition from operational proof",
    "define validator standards and forbidden-action boundaries",
    "resolve naming/canon conflicts through explicit law"
  ],
  "forbidden_actions": [
    "execute task implementation",
    "grant final trust",
    "score readiness from prose alone",
    "mutate Reality outside WARP land process",
    "treat doctrine definition as action proof",
    "claim final verdict or crown verdict"
  ],
  "accepted_inputs": [
    "owner_decision",
    "audit_finding",
    "canon_conflict",
    "schema_request",
    "validator_standard_request"
  ],
  "required_outputs": [
    "doctrine_document",
    "json_schema",
    "duty_contract",
    "rule_matrix",
    "canon_reconciliation_note"
  ],
  "required_receipts": [
    "doctrinarium_rule_validation_receipt.json",
    "organ_duty_contract_coverage_receipt.json",
    "canon_reconciliation_receipt.json"
  ],
  "rule_validators_required": [
    "doctrinarium_duty_contract_rule_validator.v0_1",
    "doctrinarium_forbidden_action_boundary_validator.v0_1"
  ],
  "action_validators_required": [
    "doctrinarium_profile_action_validator.v0_1",
    "doctrinarium_receipt_output_validator.v0_1"
  ],
  "trust_validators_required": [
    "doctrinarium_cross_organ_trust_validator.v0_1",
    "throne_doctrinarium_truth_confirmation_validator.v0_1"
  ],
  "handoff_in": [
    "OWNER",
    "THRONE",
    "INQUISITION",
    "SCHOLA_IMPERIALIS"
  ],
  "handoff_out": [
    "MECHANICUS",
    "THRONE",
    "ADMINISTRATUM"
  ],
  "audited_by": [
    "INQUISITION",
    "CUSTODES",
    "THRONE"
  ],
  "throne_must_confirm": [
    "rule does not conflict with existing canon",
    "definition stage is not counted as operation",
    "schemas are machine-checkable",
    "forbidden actions are explicit"
  ],
  "not_allowed_to_claim": [
    "self-claim as operational proof",
    "self-validator as trust proof",
    "profile baseline as implementation proof",
    "README/MANIFEST/FUNCTIONS existence as action proof",
    "target definition as achieved reality",
    "score without source/formula/evidence level"
  ],
  "minimal_v1_pass_conditions": [
    "can define organ duty contracts for all organs",
    "can validate required fields and boundaries",
    "can emit doctrine receipt without claiming operational completion"
  ],
  "proof_stage_flags": {
    "profile_baseline_detected": true,
    "duty_defined": true,
    "rule_validated": false,
    "action_proven": false,
    "trust_proven": false,
    "throne_confirmed": false
  },
  "score_policy": {
    "duty_defined_can_raise": "duty_defined_score only",
    "must_not_raise": [
      "operational_score",
      "trust_score",
      "core_v1_no_core_mutation_evidence_score"
    ],
    "stage_law": "profile_baseline != duty_defined != rule_validated != action_proven != trust_proven != throne_confirmed"
  }
}
