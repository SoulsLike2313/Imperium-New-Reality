  "status": "ACTIVE_ADVISORY_OUTPUT_LAW",
  "patch_id": "ORGAN-AGENT-ADVISORY-OUTPUT-ISOLATION-AND-VOICE-ENRICHMENT-0001",
  "purpose": "Prevent per-organ advisory calls from overwriting global advisory outputs and enrich organ-agent voice.",
  "global_outputs": [
    "ORGANS/ASTRONOMICON/REPORTS/ORGAN_AGENT_ADVISORY_SUMMARY_V0_1.json",
    "ORGANS/ASTRONOMICON/REPORTS/ORGAN_AGENT_ADVISORY_REPORT_V0_1.md",
    "ORGANS/ASTRONOMICON/RECEIPTS/organ_agent_advisory_scoring_receipt.json"
  ],
  "per_organ_output_pattern": [
    "ORGANS/ASTRONOMICON/REPORTS/ORGAN_AGENT_ADVISORY_<ORGAN>_V0_1.json",
    "ORGANS/ASTRONOMICON/REPORTS/ORGAN_AGENT_ADVISORY_<ORGAN>_V0_1.md"
  ],
  "voice_enrichment_required_fields": [
    "what_is_visible",
    "why_this_zone_matters",
    "what_raises_success_probability",
    "what_reduces_success_probability",
    "evidence_considered",
    "not_claimed"
  ],
  "hard_laws": [
    "single-organ advisory must not overwrite global advisory summary",
    "global advisory must include all 10 organs",
    "per-organ advisory must write isolated per-organ outputs",
    "advisory language may recommend attention zones but not concrete actions",
    "advisory voice must explain score factors",
    "advisory voice must state what is not claimed"
  ],
  "forbidden_direct_action_terms": [
    "run",
    "execute",
    "apply",
    "commit",
    "push",
    "delete",
    "remove",
    "copy",
    "mutate",
    "запусти",
    "выполни",
    "примени",
    "закоммить",
    "запушь",
    "удали",
    "скопируй",
    "измени"
  ],
  "organs": {
